model stock_issues {
  id                Int                 @id @default(autoincrement())
  issueNumber       String              @unique
  indentId          Int?
  fromStoreId       Int
  toStoreId         Int?
  costCenter        String?
  issuedById        String
  status            String              @default("DRAFT")
  organizationId    String
  createdAt         DateTime            @default(now())
  stock_issue_items stock_issue_items[]
  stores            stores              @relation(fields: [fromStoreId], references: [id])
  indents           indents?            @relation(fields: [indentId], references: [id])
  users             User                @relation(fields: [issuedById], references: [id])
  organizations     Organization        @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model stock_transfer_items {
  id              Int             @id @default(autoincrement())
  transferId      Int
  itemId          Int
  batchId         Int?
  quantity        Decimal
  unitCost        Decimal
  item_batches    item_batches?   @relation(fields: [batchId], references: [id])
  item_master     item_master     @relation(fields: [itemId], references: [id])
  stock_transfers stock_transfers @relation(fields: [transferId], references: [id])
}

model stock_transfers {
  id                                         Int                    @id @default(autoincrement())
  transferNumber                             String                 @unique
  fromStoreId                                Int
  toStoreId                                  Int
  status                                     String                 @default("DRAFT")
  dispatchedAt                               DateTime?
  receivedAt                                 DateTime?
  dispatchedById                             String?
  receivedById                               String?
  organizationId                             String
  createdAt                                  DateTime               @default(now())
  stock_transfer_items                       stock_transfer_items[]
  stores_stock_transfers_fromStoreIdTostores stores                 @relation("stock_transfers_fromStoreIdTostores", fields: [fromStoreId], references: [id])
  organizations                              Organization           @relation(fields: [organizationId], references: [id])
  stores_stock_transfers_toStoreIdTostores   stores                 @relation("stock_transfers_toStoreIdTostores", fields: [toStoreId], references: [id])

  @@index([organizationId])
}

model store_item_settings {
  id           Int         @id @default(autoincrement())
  storeId      Int
  itemId       Int
  parLevel     Decimal?
  reorderPoint Decimal?
  maxLevel     Decimal?
  autoIndent   Boolean     @default(false)
  item_master  item_master @relation(fields: [itemId], references: [id])
  stores       stores      @relation(fields: [storeId], references: [id])

  @@unique([storeId, itemId])
}

model store_stock {
  id               Int           @id @default(autoincrement())
  storeId          Int
  itemId           Int
  batchId          Int?
  quantityOnHand   Decimal       @default(0)
  quantityReserved Decimal       @default(0)
  avgUnitCost      Decimal       @default(0)
  binLocation      String?
  organizationId   String
  item_batches     item_batches? @relation(fields: [batchId], references: [id])
  item_master      item_master   @relation(fields: [itemId], references: [id])
  organizations    Organization  @relation(fields: [organizationId], references: [id])
  stores           stores        @relation(fields: [storeId], references: [id])

  @@unique([storeId, itemId, batchId])
  @@index([organizationId])
  @@index([storeId, itemId])
}

model stores {
  id                                                  Int                     @id @default(autoincrement())
  storeCode                                           String
  name                                                String
  storeType                                           String
  branchId                                            String?
  parentStoreId                                       Int?
  costCenter                                          String?
  inchargeUserId                                      String?
  isActive                                            Boolean                 @default(true)
  organizationId                                      String
  createdAt                                           DateTime                @default(now())
  updatedAt                                           DateTime
  goods_receipt_notes                                 GoodsReceiptNote[]
  indents_indents_fromStoreIdTostores                 indents[]               @relation("indents_fromStoreIdTostores")
  indents_indents_toStoreIdTostores                   indents[]               @relation("indents_toStoreIdTostores")
  inventory_movements                                 inventory_movements[]
  purchase_orders                                     PurchaseOrder[]
  purchase_requisitions                               purchase_requisitions[]
  stock_adjustments                                   stock_adjustments[]
  stock_count_sessions                                stock_count_sessions[]
  stock_issues                                        stock_issues[]
  stock_transfers_stock_transfers_fromStoreIdTostores stock_transfers[]       @relation("stock_transfers_fromStoreIdTostores")
  stock_transfers_stock_transfers_toStoreIdTostores   stock_transfers[]       @relation("stock_transfers_toStoreIdTostores")
  store_item_settings                                 store_item_settings[]
  store_stock                                         store_stock[]
  branches                                            Branch?                 @relation(fields: [branchId], references: [id])
  users                                               User?                   @relation(fields: [inchargeUserId], references: [id])
  organizations                                       Organization            @relation(fields: [organizationId], references: [id])
  stores                                              stores?                 @relation("storesTostores", fields: [parentStoreId], references: [id])
  other_stores                                        stores[]                @relation("storesTostores")

  @@unique([storeCode, organizationId])
  @@index([organizationId])
}
